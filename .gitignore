**/refs/
**/*.pack
scripts/yangsuite-Docker/ys-data/
scripts/yangsuite-Docker/ys-backup/
config.xml
running-config.xml
*-backup*
config.php
ISE-*.gz
ers-*.json
scripts/.public-ips

# personal sanitiser rules (your own domain and names)
scripts/.sanitize-private
