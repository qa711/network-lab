!
interface Loopback99
 ip vrf forwarding DMZ
 ip address 10.99.250.251 255.255.255.255
 ip ospf 2 area 0
!
interface Loopback100
 description RP-ANYCAST
 ip address 10.255.100.1 255.255.255.255
 ip pim sparse-mode
!
interface Loopback101
 description MSDP
 ip address 10.255.101.2 255.255.255.255
!
interface Tunnel0
 description GREto-PBR-A
 ip flow monitor FNF-MONITOR input
 ip address 172.16.12.2 255.255.255.252
 ip mtu 1400
 ip pim sparse-mode
 ip tcp adjust-mss 1360
 tunnel source GigabitEthernet2
 tunnel destination 10.10.30.2
 tunnel protection ipsec profile GRE-IPSEC-PROFILE
!
interface Tunnel10
 description GREto-PBR-A-viaCSW2
 ip address 172.16.12.6 255.255.255.252
 ip mtu 1400
 ip pim sparse-mode
 ip tcp adjust-mss 1360
 tunnel source GigabitEthernet3
 tunnel destination 10.10.60.2
 tunnel protection ipsec profile GRE-IPSEC-PROFILE
!
interface GigabitEthernet1
 description Linkto-NEXUS-B
 ip flow monitor FNF-MONITOR input
 ip address 10.10.71.2 255.255.255.252
 ip pim sparse-mode
 ip igmp join-group 239.1.1.10
 ip policy route-map PBR-POLICY
 negotiation auto
 no mop enabled
 no mop sysid
!
interface GigabitEthernet1.99
 encapsulation dot1Q 99
 ip vrf forwarding DMZ
 ip address 10.99.11.2 255.255.255.252
!
interface GigabitEthernet2
 description Linkto-CSW1
 ip flow monitor FNF-MONITOR input
 ip address 10.20.30.2 255.255.255.252
 ip pim sparse-mode
 negotiation auto
 no mop enabled
 no mop sysid
!
interface GigabitEthernet3
 description Linkto-CSW2
 ip flow monitor FNF-MONITOR input
 ip address 10.20.60.2 255.255.255.252
 ip pim sparse-mode
 negotiation auto
 no mop enabled
 no mop sysid
!
interface GigabitEthernet4
 no ip address
 shutdown
 negotiation auto
 no mop enabled
 no mop sysid
!
router ospf 2 vrf DMZ
 network 10.99.11.0 0.0.0.3 area 0
 network 10.99.250.251 0.0.0.0 area 0
!
router ospf 1
 redistribute static route-map STATIC-OSPF
 network 10.10.71.0 0.0.0.3 area 0
 network 10.20.30.0 0.0.0.3 area 0
 network 10.20.60.0 0.0.0.3 area 0
 network 10.255.100.1 0.0.0.0 area 0
 network 10.255.101.2 0.0.0.0 area 0
 network 172.16.12.0 0.0.0.3 area 0
 network 172.16.12.4 0.0.0.3 area 0
 distribute-list prefix RIB-DENY-vlan40 in
!
ip forward-protocol nd
ip pim rp-address 10.255.100.1
ip pim ssm default
ip msdp peer 10.255.101.1 connect-source Loopback101
ip msdp cache-sa-state
ip msdp originator-id Loopback101
no ip http server
ip http authentication local
ip http secure-server
!
ip route 69.69.69.69 255.255.255.255 Null0
ip ssh source-interface GigabitEthernet1.99
!
ip access-list standard SNMP-NMS
 10 permit 10.99.0.12
!
ip access-list extended PBR-ACL20
 10 permit ip 10.2.1.0 0.0.0.255 10.2.0.0 0.0.0.255
 20 permit ip 10.2.1.0 0.0.0.255 10.4.0.0 0.0.0.255
ip access-list extended PBR-ACL40
 10 permit ip 10.4.1.0 0.0.0.255 10.2.0.0 0.0.0.255
 20 permit ip 10.4.1.0 0.0.0.255 10.4.0.0 0.0.0.255
!
!
ip prefix-list REDIST-STATIC seq 5 permit 69.69.69.69/32
!
ip prefix-list RIB-DENY-vlan40 seq 5 deny 10.4.1.0/24
ip prefix-list RIB-DENY-vlan40 seq 10 permit 0.0.0.0/0 le 32
ip sla 10
 icmp-echo 10.20.30.1 source-interface GigabitEthernet2
  frequency 5
ip sla schedule 10 life forever start-time now
ip sla 20
 icmp-echo 10.20.60.1 source-interface GigabitEthernet3
  frequency 5
ip sla schedule 20 life forever start-time now
!
!
route-map STATIC-OSPF permit 10 
 match ip address prefix-list REDIST-STATIC
!
route-map PBR-POLICY permit 10 
 match ip address PBR-ACL20
 set ip next-hop verify-availability 10.20.30.1 1 track 10
 set ip next-hop verify-availability 10.20.60.1 2 track 20
!
route-map PBR-POLICY permit 20 
 match ip address PBR-ACL40
 set ip next-hop verify-availability 10.20.30.1 1 track 10
 set ip next-hop verify-availability 10.20.60.1 2 track 20
!
route-map PBR-POLICY permit 30 
!
snmp-server group nms v3 priv 
snmp-server group NMSGROUP v3 priv read NMSVIEW access SNMP-NMS
snmp-server view NMSVIEW iso included
snmp-server community <SNMP-COMMUNITY> RO SNMP-NMS
snmp-server trap-source GigabitEthernet1.99
snmp-server location Belv
snmp-server contact <CONTACT>
snmp-server enable traps snmp linkdown linkup
snmp-server enable traps ospf state-change
snmp-server enable traps ospf errors
snmp-server enable traps ospf retransmit
snmp-server enable traps ospf lsa
snmp-server enable traps ospf cisco-specific state-change nssa-trans-change
snmp-server enable traps ospf cisco-specific state-change shamlink interface
snmp-server enable traps ospf cisco-specific state-change shamlink neighbor
snmp-server enable traps ospf cisco-specific errors
snmp-server enable traps ospf cisco-specific retransmit
snmp-server enable traps ospf cisco-specific lsa
snmp-server enable traps event-manager
snmp-server enable traps hsrp
snmp-server host 10.99.0.12 version 2c <SNMP-COMMUNITY> 
