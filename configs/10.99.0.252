!Command: show running-config
!No configuration change since last restart

version 9.3(4) Bios:version  
hostname CSW2
vdc CSW2 id 1
  limit-resource vlan minimum 16 maximum 4094
  limit-resource vrf minimum 2 maximum 4096
  limit-resource port-channel minimum 0 maximum 511
  limit-resource u4route-mem minimum 248 maximum 248
  limit-resource u6route-mem minimum 96 maximum 96
  limit-resource m4route-mem minimum 58 maximum 58
  limit-resource m6route-mem minimum 8 maximum 8

feature ospf
feature interface-vlan
feature lacp

no password strength-check
username admin password <REDACTED>  role network-admin
username admin role priv-15
no ip domain-lookup
ip domain-name lab.internal
ip access-list SNMP-NMS
  10 permit ip 10.99.0.12/32 any 
copp profile strict
snmp-server contact <CONTACT>
snmp-server location Core
snmp-server source-interface traps loopback99
snmp-server source-interface informs loopback99
snmp-server user admin priv-15 auth md5 <SNMP-V3-KEY> priv <SNMP-V3-KEY> <SNMP-V3-PASS>
snmp-server user admin network-admin
snmp-server host 10.99.0.12 informs version 2c <SNMP-COMMUNITY> udp-port 161
rmon event 1 description FATAL(1) owner PMON@FATAL
rmon event 2 description CRITICAL(2) owner PMON@CRITICAL
rmon event 3 description ERROR(3) owner PMON@ERROR
rmon event 4 description WARNING(4) owner PMON@WARNING
rmon event 5 description INFORMATION(5) owner PMON@INFO
snmp-server enable traps ospf
snmp-server enable traps config ccmCLIRunningConfigChanged
snmp-server enable traps link cisco-xcvr-mon-status-chg
snmp-server enable traps system Clock-change-notification
snmp-server enable traps syslog message-generated
snmp-server community <SNMP-COMMUNITY> group network-operator
snmp-server community <SNMP-COMMUNITY> group network-operator
snmp-server community <SNMP-COMMUNITY> use-ipv4acl SNMP-NMS

vlan 1,10,20,30,40,69-70,98-99
vlan 10
  name Phones
vlan 20
  name PCs
vlan 30
  name Servers
vlan 40
  name Wi-Fi
vlan 69
  name SCADA
vlan 70
  name PLc
vlan 98
  name CISCO-CORP
vlan 99
  name DMZ-SERVICES

ip prefix-list VPN-Pool seq 5 permit 10.0.10.0/24 
route-map DMZ-STATIC-TO-OSPF-vpn permit 10
  match ip address prefix-list VPN-Pool 
route-map DMZ-STATIC-TO-OSPF-vpn deny 100
vrf context CISCO-CORP
vrf context DMZ
  ip route 10.0.10.0/24 192.168.4.2
vrf context PLc
vrf context SCADA
  description SCADA
vrf context management


interface Vlan1

interface port-channel1
  switchport mode trunk
  switchport trunk native vlan 10
  switchport trunk allowed vlan 10,20,30,40,69-70,98-99

interface Ethernet1/1
  description CISCO-CORP
  switchport mode trunk
  switchport trunk native vlan 10
  switchport trunk allowed vlan 10,20,30,40,69-70,98-99
  channel-group 1 mode active

interface Ethernet1/2
  description CISCO-CORP
  switchport mode trunk
  switchport trunk native vlan 10
  switchport trunk allowed vlan 10,20,30,40,69-70,98-99
  channel-group 1 mode active

interface Ethernet1/3
  no switchport
  no shutdown

interface Ethernet1/3.10
  description DSW-A1-SCADA
  encapsulation dot1q 69
  vrf member SCADA
  ip address 10.10.40.1/30
  ip router ospf 69 area 0.0.0.0
  no shutdown

interface Ethernet1/3.20
  description DSW-A1-PLc
  encapsulation dot1q 70
  vrf member PLc
  ip address 10.10.50.1/30
  ip router ospf 70 area 0.0.0.0
  no shutdown

interface Ethernet1/3.30
  description DSW-A1-MAIN
  encapsulation dot1q 98
  vrf member CISCO-CORP
  ip address 10.10.60.1/30
  ip router ospf 71 area 0.0.0.0
  no shutdown

interface Ethernet1/3.40
  description DSW-A1-DMZ
  encapsulation dot1q 99
  vrf member DMZ
  ip address 10.10.90.5/30
  ip router ospf 72 area 0.0.0.0
  no shutdown

interface Ethernet1/4
  no switchport
  no shutdown

interface Ethernet1/4.10
  description DSW-A2-SCADA
  encapsulation dot1q 69
  vrf member SCADA
  ip address 10.20.40.1/30
  ip router ospf 69 area 0.0.0.0
  no shutdown

interface Ethernet1/4.20
  description DSW-A2-PLc
  encapsulation dot1q 70
  vrf member PLc
  ip address 10.20.50.1/30
  ip router ospf 70 area 0.0.0.0
  no shutdown

interface Ethernet1/4.30
  description DSW-A2-MAIN
  encapsulation dot1q 98
  vrf member CISCO-CORP
  ip address 10.20.60.1/30
  ip router ospf 71 area 0.0.0.0
  no shutdown

interface Ethernet1/4.40
  description DSW-A2-DMZ
  encapsulation dot1q 99
  vrf member DMZ
  ip address 10.20.90.5/30
  ip router ospf 72 area 0.0.0.0
  no shutdown

