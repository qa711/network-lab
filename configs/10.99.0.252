interface mgmt0
  vrf member management

interface loopback0
  ip address 255.255.2.255/32

interface loopback99
  vrf member DMZ
  ip address 10.99.0.252/32
  ip router ospf 72 area 0.0.0.0
line console
line vty
boot nxos bootflash:/nxos.9.3.4.bin sup-1
router ospf 69
  vrf SCADA
    router-id 255.255.2.255
    log-adjacency-changes
    area 0.0.0.0 range 10.10.40.0/30
    area 0.0.0.0 range 10.20.40.0/30
    area 0.0.0.0 range 10.30.40.0/30
    area 0.0.0.0 range 10.40.40.0/30
    area 0.0.0.0 range 10.150.20.0/30
    area 0.0.0.0 range 255.255.2.255/32
router ospf 70
  vrf PLc
    router-id 255.255.2.255
    log-adjacency-changes
    area 0.0.0.0 range 10.10.50.0/30
    area 0.0.0.0 range 10.20.50.0/30
    area 0.0.0.0 range 10.30.50.0/30
    area 0.0.0.0 range 10.40.50.0/30
    area 0.0.0.0 range 10.250.20.0/30
    area 0.0.0.0 range 255.255.2.255/32
router ospf 71
  vrf CISCO-CORP
    router-id 255.255.2.255
    log-adjacency-changes
    area 0.0.0.0 range 10.10.60.0/30
    area 0.0.0.0 range 10.20.60.0/30
    area 0.0.0.0 range 10.30.60.0/30
    area 0.0.0.0 range 10.40.60.0/30
    area 0.0.0.0 range 10.60.20.0/30
    area 0.0.0.0 range 192.168.3.0/30
    area 0.0.0.0 range 255.255.2.255/32
router ospf 72
  vrf DMZ
    router-id 255.255.2.255
    redistribute static route-map DMZ-STATIC-TO-OSPF-vpn
    log-adjacency-changes
    area 0.0.0.0 range 10.10.90.0/30
    area 0.0.0.0 range 10.10.90.4/30
    area 0.0.0.0 range 10.20.90.0/30
    area 0.0.0.0 range 10.20.90.4/30
    area 0.0.0.0 range 10.30.90.0/30
    area 0.0.0.0 range 10.30.90.4/30
    area 0.0.0.0 range 10.40.90.0/30
    area 0.0.0.0 range 10.40.90.4/30
    area 0.0.0.0 range 10.60.90.0/30
    area 0.0.0.0 range 192.168.2.0/30
    area 0.0.0.0 range 192.168.4.0/30



