  no switchport
  no shutdown

interface Ethernet1/5.10
  description DSW-B1-SCADA
  encapsulation dot1q 69
  vrf member SCADA
  ip address 10.30.40.1/30
  ip router ospf 69 area 0.0.0.0
  no shutdown

interface Ethernet1/5.20
  description DSW-B1-PLc
  encapsulation dot1q 70
  vrf member PLc
  ip address 10.30.50.1/30
  ip router ospf 70 area 0.0.0.0
  no shutdown

interface Ethernet1/5.30
  description DSW-B1-MAIN
  encapsulation dot1q 98
  vrf member CISCO-CORP
  ip address 10.30.60.1/30
  ip router ospf 71 area 0.0.0.0
  no shutdown

interface Ethernet1/5.40
  description DSW-B1-DMZ
  encapsulation dot1q 99
  vrf member DMZ
  ip address 10.30.90.5/30
  ip router ospf 72 area 0.0.0.0
  no shutdown

interface Ethernet1/6
  no switchport
  no shutdown

interface Ethernet1/6.10
  description DSW-B2-SCADA
  encapsulation dot1q 69
  vrf member SCADA
  ip address 10.40.40.1/30
  ip router ospf 69 area 0.0.0.0
  no shutdown

interface Ethernet1/6.20
  description DSW-B2-PLc
  encapsulation dot1q 70
  vrf member PLc
  ip address 10.40.50.1/30
  ip router ospf 70 area 0.0.0.0
  no shutdown

interface Ethernet1/6.30
  description DSW-B2-MAIN
  encapsulation dot1q 98
  vrf member CISCO-CORP
  ip address 10.40.60.1/30
  ip router ospf 71 area 0.0.0.0
  no shutdown

interface Ethernet1/6.40
  description DSW-B2-DMZ
  encapsulation dot1q 99
  vrf member DMZ
  ip address 10.40.90.5/30
  ip router ospf 72 area 0.0.0.0
  no shutdown

interface Ethernet1/7
  no switchport
  no shutdown

interface Ethernet1/7.1

interface Ethernet1/7.10
  encapsulation dot1q 69
  vrf member SCADA
  ip address 10.150.20.2/30
  ip ospf network point-to-point
  ip router ospf 69 area 0.0.0.0
  no shutdown

interface Ethernet1/7.20
  encapsulation dot1q 70
  vrf member PLc
  ip address 10.250.20.2/30
  ip ospf network point-to-point
  ip router ospf 70 area 0.0.0.0
  no shutdown

interface Ethernet1/7.30
  encapsulation dot1q 98
  vrf member CISCO-CORP
