  ip ospf network point-to-point
  ip router ospf 71 area 0.0.0.0
  no shutdown

interface Ethernet1/7.40
  encapsulation dot1q 99
  vrf member DMZ
  ip address 10.60.90.1/30
  ip ospf network point-to-point
  ip router ospf 72 area 0.0.0.0
  no shutdown

interface Ethernet1/8
  description OPNsense-DMZ-OSPF
  no switchport
  vrf member DMZ
  ip address 192.168.4.1/24
  ip router ospf 72 area 0.0.0.0
  no shutdown

interface Ethernet1/9
  no switchport
  vrf member CISCO-CORP
  ip address 192.168.3.2/30
  ip router ospf 71 area 0.0.0.0
  no shutdown

interface Ethernet1/10
  no switchport
  vrf member DMZ
  ip address 192.168.2.2/30
  ip router ospf 72 area 0.0.0.0
  no shutdown

