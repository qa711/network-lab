!Command: show running-config
!Running configuration last done at: Sat Oct 24 14:03:49 2026

version 9.3(4) Bios:version  
hostname CSW1
vdc CSW1 id 1
  limit-resource vlan minimum 16 maximum 4094
  limit-resource vrf minimum 2 maximum 4096
  limit-resource port-channel minimum 0 maximum 511
  limit-resource u4route-mem minimum 248 maximum 248
  limit-resource u6route-mem minimum 96 maximum 96
  limit-resource m4route-mem minimum 58 maximum 58
  limit-resource m6route-mem minimum 8 maximum 8

feature tacacs+
feature ospf
feature pim
feature interface-vlan
feature lacp

no password strength-check
username admin password <REDACTED>  role network-admin
username automate password <REDACTED>  role network-admin
username automate passphrase  lifetime 99999 warntime 14 gracetime 3
ip domain-lookup
ip domain-name lab.internal
ip name-server 10.99.0.12 use-vrf DMZ
tacacs-server host 10.99.0.50 key <TACACS-KEY> 
tacacs-server host 10.99.0.12 key <TACACS-KEY> 
aaa group server tacacs+ ISE-GROUP 
    server 10.99.0.50 
    use-vrf DMZ
    source-interface loopback99
aaa group server tacacs+ TAC-GROUP 
    server 10.99.0.12 
    use-vrf DMZ
    source-interface loopback99
ip access-list PBR-HOST
  10 permit ip any 10.99.0.10/32 
ip access-list SNMP-NMS
  10 permit ip 10.99.0.12/32 any 
copp profile strict
snmp-server contact <CONTACT>
snmp-server location Core
snmp-server source-interface traps loopback99
snmp-server source-interface informs loopback99
snmp-server user admin network-admin auth sha <SNMP-V3-KEY> priv aes-128 <SNMP-V3-PASS> localizedkey
snmp-server user automate network-admin auth sha <SNMP-V3-KEY> priv aes-128 <SNMP-V3-PASS> localizedkey
snmp-server host 10.99.0.12 traps version 2c <SNMP-COMMUNITY>
snmp-server host 10.99.0.12 use-vrf DMZ
rmon event 1 description FATAL(1) owner PMON@FATAL
rmon event 2 description CRITICAL(2) owner PMON@CRITICAL
rmon event 3 description ERROR(3) owner PMON@ERROR
rmon event 4 description WARNING(4) owner PMON@WARNING
rmon event 5 description INFORMATION(5) owner PMON@INFO
snmp-server enable traps ospf
snmp-server enable traps config ccmCLIRunningConfigChanged
snmp-server enable traps link cisco-xcvr-mon-status-chg
snmp-server enable traps system Clock-change-notification
snmp-server enable traps syslog message-generated
snmp-server community <SNMP-COMMUNITY> group network-operator
ntp server 10.99.0.12 use-vrf DMZ
ntp server 192.168.4.2 use-vrf DMZ
ntp source 10.99.1.251
aaa authentication login default group ISE-GROUP local 
aaa authentication login console local 
aaa accounting default group ISE-GROUP 
aaa authentication login error-enable 

vlan 1,10,20,30,40,69-70,98-99
vlan 10
  name Phones
vlan 20
  name PCs
vlan 30
  name Servers
vlan 40
  name Wi-Fi
vlan 69
  name SCADA
vlan 70
  name PLc
vlan 98
  name CISCO-CORP
vlan 99
  name DMZ-SERVICES

vrf context CISCO-CORP
  ip route 10.99.0.0/24 10.255.250.10
  ip pim rp-address 10.255.100.1 group-list 224.0.0.0/4
  ip pim ssm range 232.0.0.0/8
vrf context DMZ
  ip route 0.0.0.0/0 10.255.250.14
  ip route 10.69.0.0/27 10.255.250.14
  ip route 10.69.1.0/27 10.255.250.14
  ip route 10.70.0.0/27 10.255.250.14
  ip route 10.70.1.0/27 10.255.250.14
  ip route 10.98.0.0/24 10.255.250.14
  ip route 10.98.1.0/24 10.255.250.14
vrf context PLc
  ip route 10.99.0.10/32 10.255.250.6
  ip route 10.99.0.11/32 10.255.250.6
vrf context SCADA
  description SCADA
  ip route 10.99.0.10/32 10.255.250.2
  ip route 10.99.0.11/32 10.255.250.2
vrf context management

interface Vlan1

interface port-channel1
  switchport mode trunk
  switchport trunk native vlan 10
  switchport trunk allowed vlan 10,20,30,40,69-70,98-99

interface Ethernet1/1
  description CISCO-CORP
  switchport mode trunk
  switchport trunk native vlan 10
  switchport trunk allowed vlan 10,20,30,40,69-70,98-99
  channel-group 1 mode active

interface Ethernet1/2
  description CISCO-CORP
  switchport mode trunk
  switchport trunk native vlan 10
  switchport trunk allowed vlan 10,20,30,40,69-70,98-99
  channel-group 1 mode active

interface Ethernet1/3
  no switchport
  no shutdown

