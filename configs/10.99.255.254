interface Loopback99
 vrf forwarding DMZ
 ip address 10.99.255.254 255.255.255.255
 ip ospf 72 area 0
!
interface GigabitEthernet1
 description CSW2
 no ip address
 negotiation auto
 no mop enabled
 no mop sysid
!
interface GigabitEthernet1.10
 description CSW-2-SCADA
 encapsulation dot1Q 69
 vrf forwarding SCADA
 ip address 10.150.20.1 255.255.255.252
 ip ospf network point-to-point
 ip ospf 69 area 0
!
interface GigabitEthernet1.20
 description CSW-2-PLc
 encapsulation dot1Q 70
 vrf forwarding PLc
 ip address 10.250.20.1 255.255.255.252
 ip ospf network point-to-point
 ip ospf 70 area 0
!
interface GigabitEthernet1.30
 description CSW-2-CISCO-CORP
 encapsulation dot1Q 98
 vrf forwarding CISCO-CORP
 ip address 10.60.20.1 255.255.255.252
 ip ospf network point-to-point
 ip ospf 71 area 0
!
interface GigabitEthernet1.40
 description CSW2-DMZ
 encapsulation dot1Q 99
 vrf forwarding DMZ
 ip address 10.60.90.2 255.255.255.252
 ip ospf network point-to-point
 ip ospf 72 area 0
!
interface GigabitEthernet2
 description PE2
 ip address 192.168.20.2 255.255.255.252
 negotiation auto
 no mop enabled
 no mop sysid
!
interface GigabitEthernet2.10
 description PE-2-SCADA
 encapsulation dot1Q 69
 vrf forwarding SCADA
 ip address 10.150.10.1 255.255.255.252
 ip ospf network point-to-point
 ip ospf 69 area 0
!
interface GigabitEthernet2.20
 description PE-2-PLc
 encapsulation dot1Q 70
 vrf forwarding PLc
 ip address 10.250.10.1 255.255.255.252
 ip ospf network point-to-point
 ip ospf 70 area 0
!
interface GigabitEthernet2.30
 description PE-2-CISCO-CORP
 encapsulation dot1Q 98
 vrf forwarding CISCO-CORP
 ip address 10.60.10.1 255.255.255.252
 ip ospf network point-to-point
 ip ospf 71 area 0
!
interface GigabitEthernet3
 no ip address
 shutdown
 negotiation auto
 no mop enabled
 no mop sysid
!
interface GigabitEthernet4
 no ip address
 shutdown
 negotiation auto
 no mop enabled
 no mop sysid
!
router ospf 72 vrf DMZ
 router-id 200.200.2.72
!
router ospf 69 vrf SCADA
 router-id 200.200.2.69
!
router ospf 70 vrf PLc
 router-id 200.200.2.70
!
router ospf 71 vrf CISCO-CORP
 router-id 200.200.2.71
!
ip forward-protocol nd
no ip http server
ip http authentication local
no ip http secure-server
!
ip ssh version 2
!
ip access-list standard SNMP-NMS
 10 permit 10.99.0.12
!
!
logging source-interface Loopback99 vrf DMZ
logging host 10.99.0.12 vrf DMZ
!
!
snmp-server view NMSVIEW iso included
snmp-server community <SNMP-COMMUNITY> RO SNMP-NMS
snmp-server trap-source Loopback99
snmp-server location Core
snmp-server contact <CONTACT>
snmp-server enable traps snmp linkdown linkup coldstart warmstart
snmp-server enable traps ospf state-change
snmp-server enable traps config
snmp-server host 10.99.0.12 vrf DMZ version 2c <SNMP-COMMUNITY> 
!
tacacs server ISE-TAC
 address ipv4 10.99.0.50
 key <REDACTED-KEY>
!
!
!
!
control-plane
!
!
!
!
!
!
line con 0
 stopbits 1
line vty 0 4
 authorization commands 1 CMD-AUTHZ1
 authorization commands 15 CMD-AUTHZ
 authorization exec VTY-ISE-AUTHZ
 accounting commands 15 CMD-ACCT
 accounting exec VTY-ACCT
 login authentication VTY-ISE
 transport input ssh
line vty 5 15
 authorization commands 1 CMD-AUTHZ1
 authorization commands 15 CMD-AUTHZ
 authorization exec VTY-ISE-AUTHZ
 accounting commands 15 CMD-ACCT
 accounting exec VTY-ACCT
 login authentication VTY-ISE
 transport input ssh
!
call-home
 ! If contact email address in call-home is configured as sch-smart-licensing@cisco.com
 ! the email address configured in Cisco Smart License Portal will be used as contact email address to send SCH notifications.
 contact-email-addr sch-smart-licensing@cisco.com
 profile "CiscoTAC-1"
  active
  destination transport-method http
ntp source Loopback99
ntp server vrf DMZ 192.168.4.2
ntp server vrf DMZ 10.99.0.12
