version 17.3
service timestamps debug datetime msec
service timestamps log datetime msec
service password-encryption
service call-home
platform qfp utilization monitor load 80
platform punt-keepalive disable-kernel-core
platform console serial
!
hostname CORP-PBR-A
!
boot-start-marker
boot-end-marker
!
!
!
aaa new-model
!
!
aaa group server tacacs+ TAC-GROUP
 server name NMS-TAC
 ip vrf forwarding DMZ
 ip tacacs source-interface Loopback99
!
aaa group server radius RAD-GROUP
 server name NMS-RAD
!
aaa group server tacacs+ ISE-GROUP
 server name ISE-TAC
 ip vrf forwarding DMZ
 ip tacacs source-interface Loopback99
!
aaa authentication login default local
aaa authentication login VTY-AUTH group TAC-GROUP local
aaa authentication login VTY-OTP group RAD-GROUP local
aaa authentication login VTY-ISE group ISE-GROUP local
aaa authorization exec VTY-AUTHZ group TAC-GROUP local 
aaa authorization exec VTY-OTP-AUTHZ group RAD-GROUP local 
aaa authorization exec VTY-ISE-AUTHZ group ISE-GROUP local 
aaa authorization commands 1 CMD-AUTHZ1 group ISE-GROUP local 
aaa authorization commands 15 CMD-AUTHZ group ISE-GROUP local 
aaa accounting exec VTY-ACCT start-stop group TAC-GROUP
aaa accounting commands 15 CMD-ACCT start-stop group ISE-GROUP
!
!
!
!
!
!
aaa session-id common
!
ip vrf DMZ
 rd 65001:4
!
ip multicast-routing distributed
!
!
!
!
!
!
ip name-server vrf DMZ 10.99.0.12
ip domain name lab.internal
!
!
!
login on-success log
!
!
!
!
!
!
!
subscriber templating
! 
! 
! 
! 
!
!
!
flow record FNF-RECORD
 match ipv4 source address
 match ipv4 destination address
 match transport source-port
 match transport destination-port
 match ipv4 protocol
 match interface input
 collect ipv4 dscp
 collect counter bytes long
 collect timestamp sys-uptime first
 collect timestamp sys-uptime last
!
!
flow exporter FNF-EXPORTER
 destination 10.99.0.12 vrf DMZ
 source Loopback99
 transport udp 2055
 template data timeout 10
!
!
flow monitor FNF-MONITOR
 exporter FNF-EXPORTER
 cache timeout active 60
 record FNF-RECORD
!
multilink bundle-name authenticated
!
!
!
!
!
!
!
!
!
!
!
!
!
!
!
crypto pki trustpoint TP-self-signed-3351939589
 enrollment selfsigned
 subject-name cn=IOS-Self-Signed-Certificate-3351939589
 revocation-check none
 rsakeypair TP-self-signed-3351939589
!
crypto pki trustpoint SLA-TrustPoint
 enrollment pkcs12
 revocation-check crl
!
!
  <CERTIFICATE-REDACTED>
  <CERTIFICATE-REDACTED>
  <CERTIFICATE-REDACTED>
  <CERTIFICATE-REDACTED>
!
license udi pid CSR1000V sn <SERIAL>
diagnostic bootup level minimal
memory free low-watermark processor 71464
!
!
spanning-tree extend system-id
!
username admin privilege 15 password <REDACTED>
username api privilege 15 secret <REDACTED>
username automate privilege 15 secret <REDACTED>
!
redundancy
!
!
!
!
!
!
cdp run
!
track 10 ip sla 10 reachability
!
track 20 ip sla 20 reachability
!
!
class-map match-any BUSINESS
 match dscp af31 
class-map match-any VOICE
 match dscp ef 
class-map match-any MARK-BUSINESSS
 match access-group name QOS-BUSINESS-SIM
class-map match-any MARK-VOICE
 match access-group name QOS-VOICE-SIM
!
policy-map WAN-OUT
 class VOICE
  priority percent 20
 class BUSINESS
  bandwidth percent 30 
 class class-default
  fair-queue
policy-map WAN-SHAPE
 class class-default
  shape average 1000000   
   service-policy WAN-OUT
policy-map MARK-IN
 class MARK-VOICE
  set dscp ef
 class MARK-BUSINESSS
  set dscp af31
!
! 
!
!
!
!
!
!
!
crypto isakmp policy 10
 encryption aes 256
 hash sha256
 authentication pre-share
 group 14
!
crypto isakmp policy 20
 encryption aes 256
 hash sha256
 authentication pre-share
 group 14
crypto isakmp key <PSK> address 10.20.30.2     
crypto isakmp key <PSK> address 10.20.60.2     
!
!
crypto ipsec transform-set GRE-TS esp-aes 256 esp-sha-hmac 
 mode transport
!
crypto ipsec profile GRE-IPSEC-PROFILE
 set transform-set GRE-TS 
!
