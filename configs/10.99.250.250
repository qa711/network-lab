!
interface Loopback99
 description MGMTip
 ip vrf forwarding DMZ
 ip address 10.99.250.250 255.255.255.255
!
interface Loopback100
 description RP-ANYCAST
 ip address 10.255.100.1 255.255.255.255
 ip pim sparse-mode
!
interface Loopback101
 description MSDP
 ip address 10.255.101.1 255.255.255.255
!
interface Tunnel0
 description GREto-PBR-B
 ip address 172.16.12.1 255.255.255.252
 ip mtu 1400
 ip pim sparse-mode
 ip tcp adjust-mss 1360
 tunnel source GigabitEthernet2
 tunnel destination 10.20.30.2
 tunnel protection ipsec profile GRE-IPSEC-PROFILE
!
interface Tunnel10
 description GREto-PBR-B-viaCSW2
 ip address 172.16.12.5 255.255.255.252
 ip mtu 1400
 ip pim sparse-mode
 ip tcp adjust-mss 1360
 tunnel source GigabitEthernet3
 tunnel destination 10.20.60.2
 tunnel protection ipsec profile GRE-IPSEC-PROFILE
!
interface GigabitEthernet1
 description Linkto-Nexus-A
 ip flow monitor FNF-MONITOR input
 ip address 10.10.70.2 255.255.255.252
 ip pim sparse-mode
 ip policy route-map PBR-POLICY
 negotiation auto
 no mop enabled
 no mop sysid
 service-policy input MARK-IN
!
interface GigabitEthernet1.99
 encapsulation dot1Q 99
 ip vrf forwarding DMZ
 ip address 10.99.10.2 255.255.255.252
!
interface GigabitEthernet2
 description Linkto-CSW1
 ip flow monitor FNF-MONITOR input
 ip address 10.10.30.2 255.255.255.252
 ip pim sparse-mode
 negotiation auto
 no mop enabled
 no mop sysid
!
interface GigabitEthernet3
 description Linkto-CSW2
 ip flow monitor FNF-MONITOR input
 ip address 10.10.60.2 255.255.255.252
 ip pim sparse-mode
 negotiation auto
 no mop enabled
 no mop sysid
!
interface GigabitEthernet4
 no ip address
 shutdown
 negotiation auto
 no mop enabled
 no mop sysid
!
router ospf 2 vrf DMZ
 network 10.99.10.0 0.0.0.3 area 0
 network 10.99.250.250 0.0.0.0 area 0
!
router ospf 1
 redistribute static route-map STATIC-OSPF
 network 10.10.30.0 0.0.0.3 area 0
 network 10.10.60.0 0.0.0.3 area 0
 network 10.10.70.0 0.0.0.3 area 0
 network 10.255.100.1 0.0.0.0 area 0
 network 10.255.101.1 0.0.0.0 area 0
 network 172.16.12.0 0.0.0.3 area 0
 network 172.16.12.4 0.0.0.3 area 0
!
ip forward-protocol nd
ip pim rp-address 10.255.100.1
ip pim ssm default
ip msdp peer 10.255.101.2 connect-source Loopback101
ip msdp cache-sa-state
ip msdp originator-id Loopback101
no ip http server
ip http authentication aaa login-authentication default
ip http authentication aaa exec-authorization default
ip http secure-server
!
ip route 192.168.100.0 255.255.255.0 Null0
ip ssh source-interface GigabitEthernet1.99
!
ip access-list standard SNMP-NMS
 10 permit 10.99.0.12
!
ip access-list extended NETCONF-ACCESS
 10 permit ip any host 10.99.0.12
 20 deny   ip any any
ip access-list extended PBR-ACL20
 10 permit ip 10.2.0.0 0.0.0.255 10.2.1.0 0.0.0.255
 20 permit ip 10.2.0.0 0.0.0.255 10.4.1.0 0.0.0.255
ip access-list extended PBR-ACL40
 10 permit ip 10.4.0.0 0.0.0.255 10.2.1.0 0.0.0.255
 20 permit ip 10.4.0.0 0.0.0.255 10.4.1.0 0.0.0.255
ip access-list extended QOS-BUSINESS-SIM
 10 permit tcp any any eq 22
 20 permit tcp any eq 22 any
ip access-list extended QOS-VOICE-SIM
 10 permit icmp any any
!
!
ip prefix-list REDIST-STATIC seq 5 permit 192.168.100.0/24
ip sla 10
 icmp-echo 10.10.30.1 source-interface GigabitEthernet2
  frequency 5
ip sla schedule 10 life forever start-time now
ip sla 20
 icmp-echo 10.10.60.1 source-interface GigabitEthernet3
  frequency 5
ip sla schedule 20 life forever start-time now
logging source-interface Loopback99 vrf DMZ
logging host 10.99.0.12 vrf DMZ
ip access-list standard 50
 10 permit 10.99.0.12 log
!
!
route-map STATIC-OSPF permit 10 
 match ip address prefix-list REDIST-STATIC
!
route-map PBR-POLICY permit 10 
 match ip address PBR-ACL20
 set ip next-hop verify-availability 10.10.30.1 1 track 10
 set ip next-hop verify-availability 10.10.60.1 2 track 20
!
route-map PBR-POLICY permit 20 
 match ip address PBR-ACL40
 set ip next-hop verify-availability 10.10.60.1 1 track 20
 set ip next-hop verify-availability 10.10.30.1 2 track 10
!
route-map PBR-POLICY permit 30 
!
snmp-server group nms v3 priv 
snmp-server group NMSGROUP v3 priv read NMSVIEW access SNMP-NMS
snmp-server view NMSVIEW iso included
snmp-server community <SNMP-COMMUNITY> RO SNMP-NMS
snmp-server trap-source Loopback99
snmp-server location Gret
snmp-server enable traps snmp linkdown linkup coldstart warmstart
snmp-server enable traps ospf state-change
snmp-server enable traps config
snmp-server host 10.99.0.12 vrf DMZ version 2c <SNMP-COMMUNITY> 
!
tacacs server NMS-TAC
 address ipv4 10.99.0.12
 key <REDACTED-KEY>
tacacs server ISE-TAC
 address ipv4 10.99.0.50
 key <REDACTED-KEY>
!
!
!
radius server NMS-RAD
 address ipv4 10.99.0.12 auth-port 1812 acct-port 1813
 key <REDACTED-KEY>
!
!
control-plane
