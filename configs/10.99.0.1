ip prefix-list DENY-VLAN10-OUT seq 5 deny 10.1.0.0/24 
ip prefix-list DENY-VLAN10-OUT seq 10 permit 0.0.0.0/0 le 32 
ip prefix-list VPN-Pool seq 5 permit 10.0.10.0/24 
ip prefix-list VPN-Pool seq 10 permit 172.16.99.0/24 
ip prefix-list VPN-Pool seq 15 permit 10.250.253.0/24 
ip prefix-list VPN-Pool seq 20 permit 10.99.254.254/32 
route-map DENY-VLAN10-OUT permit 10
